<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain HTTP to localhost for testing against a local mock.
     Reach the host via `adb reverse tcp:8765 tcp:8765` (works on any emulator and on a USB-connected phone). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
